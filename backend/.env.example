# ==============================================================================
# SAMBHAV QUANTUM PLATFORM — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development: sqlite:///sambhav.db
# Google Cloud SQL (PostgreSQL): postgresql://<DB_USER>:<DB_PASSWORD>@<CLOUD_SQL_IP_OR_HOST>:5432/<DB_NAME>
DATABASE_URL=sqlite:///sambhav.db

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Production: Provide a strong 256-bit random secret string
JWT_SECRET_KEY=change_this_to_a_secure_random_256_bit_secret_in_production

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI INTEGRATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Google AI Studio / Cloud Gemini API key (never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE & 2-FACTOR OTP VERIFICATION
# ------------------------------------------------------------------------------
# Production SMTP (e.g., SendGrid, Mailgun, Amazon SES, or Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sambhav.edu
SMTP_TLS=True

# ------------------------------------------------------------------------------
# 5. CORS & NETWORKING CONFIGURATION
# ------------------------------------------------------------------------------
# Production frontend domain (e.g., https://synapse-pbp47.web.app or custom domain)
FRONTEND_ORIGIN=https://synapse-pbp47.web.app
# Additional comma-separated allowed CORS origins
CORS_ORIGINS=https://synapse-pbp47.web.app,https://synapse-pbp47.firebaseapp.com

# ------------------------------------------------------------------------------
# 6. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
